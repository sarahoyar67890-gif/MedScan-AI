# Copy this file to .env and adjust as needed. Nothing in this project
# requires a secret API key — these are deployment/runtime knobs only.

# Comma-separated list of origins allowed to call the FastAPI backend.
# In local dev this is the Streamlit app's own origin.
MEDSCAN_CORS_ORIGINS=http://localhost:8501

# Logging verbosity for the backend service: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Base URL the Streamlit app would use if it called the API over HTTP
# instead of in-process (not required for the default single-process setup;
# reserved for a future split-service deployment).
MEDSCAN_API_BASE_URL=http://localhost:8000
